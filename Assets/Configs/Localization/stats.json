{
    "Texts": [
        {
            "Id": "strength_name",
            "Lang": [
                {
                    "Value": "Сила"
                },
                {
                    "Value": "Strength"
                },
                {
                    "Value": "Güç"
                }
            ]
        },
        {
            "Id": "strength_description",
            "Lang": [
                {
                    "Value": "Влияет на физический урон, тяжёлую добычу и бонусы к шахте и лесозаготовке."
                },
                {
                    "Value": "Affects physical damage, heavy gathering, and bonuses to mining and woodcutting."
                },
                {
                    "Value": "Fiziksel hasarı, ağır toplama işlerini, madencilik ve odunculuk bonuslarını etkiler."
                }
            ]
        },
        {
            "Id": "agility_name",
            "Lang": [
                {
                    "Value": "Ловкость"
                },
                {
                    "Value": "Agility"
                },
                {
                    "Value": "Çeviklik"
                }
            ]
        },
        {
            "Id": "agility_description",
            "Lang": [
                {
                    "Value": "Влияет на скорость атаки, шанс крита и охоту."
                },
                {
                    "Value": "Affects attack speed, critical chance, and hunting."
                },
                {
                    "Value": "Saldırı hızını, kritik şansını ve avcılığı etkiler."
                }
            ]
        },
        {
            "Id": "intelligence_name",
            "Lang": [
                {
                    "Value": "Интеллект"
                },
                {
                    "Value": "Intelligence"
                },
                {
                    "Value": "Zekâ"
                }
            ]
        },
        {
            "Id": "intelligence_description",
            "Lang": [
                {
                    "Value": "Влияет на ремесло, крафт и исследование."
                },
                {
                    "Value": "Affects crafting, production, and exploration."
                },
                {
                    "Value": "Zanaatı, üretimi ve keşfi etkiler."
                }
            ]
        },
        {
            "Id": "endurance_name",
            "Lang": [
                {
                    "Value": "Выносливость"
                },
                {
                    "Value": "Endurance"
                },
                {
                    "Value": "Dayanıklılık"
                }
            ]
        },
        {
            "Id": "endurance_description",
            "Lang": [
                {
                    "Value": "Влияет на здоровье в бою, снижение усталости и тяжёлые задачи."
                },
                {
                    "Value": "Affects combat health, fatigue reduction, and heavy tasks."
                },
                {
                    "Value": "Savaş sağlığını, yorgunluk azaltmayı ve ağır görevleri etkiler."
                }
            ]
        },
        {
            "Id": "luck_name",
            "Lang": [
                {
                    "Value": "Удача"
                },
                {
                    "Value": "Luck"
                },
                {
                    "Value": "Şans"
                }
            ]
        },
        {
            "Id": "luck_description",
            "Lang": [
                {
                    "Value": "Влияет на редкий лут, криты, качество крафта и находки."
                },
                {
                    "Value": "Affects rare loot, critical hits, crafting quality, and discoveries."
                },
                {
                    "Value": "Nadir ganimeti, kritik vuruşları, üretim kalitesini ve buluntuları etkiler."
                }
            ]
        },
        {
            "Id": "mining_name",
            "Lang": [
                {
                    "Value": "Горное дело"
                },
                {
                    "Value": "Mining"
                },
                {
                    "Value": "Madencilik"
                }
            ]
        },
        {
            "Id": "mining_description",
            "Lang": [
                {
                    "Value": "Качается добычей камня, руды и самоцветов. Даёт больше добычи и шанс редкой руды."
                },
                {
                    "Value": "Improves by gathering stone, ore, and gems. Grants more yield and a chance for rare ore."
                },
                {
                    "Value": "Taş, cevher ve mücevher çıkararak gelişir. Daha fazla verim ve nadir cevher şansı sağlar."
                }
            ]
        },
        {
            "Id": "woodcutting_name",
            "Lang": [
                {
                    "Value": "Лесозаготовка"
                },
                {
                    "Value": "Woodcutting"
                },
                {
                    "Value": "Odunculuk"
                }
            ]
        },
        {
            "Id": "woodcutting_description",
            "Lang": [
                {
                    "Value": "Качается рубкой леса и сбором древесины. Даёт больше дерева и шанс редкой древесины."
                },
                {
                    "Value": "Improves by chopping trees and gathering timber. Grants more wood and a chance for rare timber."
                },
                {
                    "Value": "Ağaç keserek ve kereste toplayarak gelişir. Daha fazla odun ve nadir kereste şansı sağlar."
                }
            ]
        },
        {
            "Id": "hunting_name",
            "Lang": [
                {
                    "Value": "Охота"
                },
                {
                    "Value": "Hunting"
                },
                {
                    "Value": "Avcılık"
                }
            ]
        },
        {
            "Id": "hunting_description",
            "Lang": [
                {
                    "Value": "Качается охотой, звериными заданиями и лесными боями. Даёт еду, кожу, клыки и бонус против зверей."
                },
                {
                    "Value": "Improves through hunts, beast tasks, and forest fights. Grants food, leather, fangs, and a bonus against beasts."
                },
                {
                    "Value": "Avlar, yaratık görevleri ve orman savaşlarıyla gelişir. Yiyecek, deri, diş ve yaratıklara karşı bonus sağlar."
                }
            ]
        },
        {
            "Id": "crafting_name",
            "Lang": [
                {
                    "Value": "Ремесло"
                },
                {
                    "Value": "Crafting"
                },
                {
                    "Value": "Zanaat"
                }
            ]
        },
        {
            "Id": "crafting_description",
            "Lang": [
                {
                    "Value": "Качается крафтом, ремонтом и кузнечными заказами. Даёт скорость крафта и шанс качества."
                },
                {
                    "Value": "Improves through crafting, repairs, and smithing orders. Grants crafting speed and a quality chance."
                },
                {
                    "Value": "Üretim, onarım ve demirci siparişleriyle gelişir. Üretim hızı ve kalite şansı sağlar."
                }
            ]
        },
        {
            "Id": "exploration_name",
            "Lang": [
                {
                    "Value": "Исследование"
                },
                {
                    "Value": "Exploration"
                },
                {
                    "Value": "Keşif"
                }
            ]
        },
        {
            "Id": "exploration_description",
            "Lang": [
                {
                    "Value": "Качается в руинах, разведке, тайниках и на карте."
                },
                {
                    "Value": "Swings in ruins, exploration, caches and on the map."
                },
                {
                    "Value": "Harabelerde, keşiflerde, önbelleklerde ve haritada salıncaklar."
                }
            ]
        },
        {
            "Id": "combat_name",
            "Lang": [
                {
                    "Value": "Бой"
                },
                {
                    "Value": "Combat"
                },
                {
                    "Value": "Savaş"
                }
            ]
        },
        {
            "Id": "combat_description",
            "Lang": [
                {
                    "Value": "Качается автобоем, катакомбами, руинами и боссами. Даёт урон, крит и выживаемость в бою."
                },
                {
                    "Value": "Improves through auto battle, catacombs, ruins, and bosses. Grants damage, critical power, and combat survivability."
                },
                {
                    "Value": "Otomatik savaş, katakomblar, harabeler ve bosslarla gelişir. Hasar, kritik güç ve savaşta hayatta kalma sağlar."
                }
            ]
        },
        {
            "Id": "damage_name",
            "Lang": [
                {
                    "Value": "Урон"
                },
                {
                    "Value": "Damage"
                },
                {
                    "Value": "Hasar"
                }
            ]
        },
        {
            "Id": "damage_description",
            "Lang": [
                {
                    "Value": "Зависит от оружия, силы и навыка боя."
                },
                {
                    "Value": "Depends on weapon, strength, and combat skill."
                },
                {
                    "Value": "Silaha, güce ve savaş becerisine bağlıdır."
                }
            ]
        },
        {
            "Id": "health_name",
            "Lang": [
                {
                    "Value": "Здоровье"
                },
                {
                    "Value": "Health"
                },
                {
                    "Value": "Sağlık"
                }
            ]
        },
        {
            "Id": "health_description",
            "Lang": [
                {
                    "Value": "Зависит от выносливости, брони и уровня."
                },
                {
                    "Value": "Depends on endurance, armor, and level."
                },
                {
                    "Value": "Dayanıklılığa, zırha ve seviyeye bağlıdır."
                }
            ]
        },
        {
            "Id": "attack_speed_name",
            "Lang": [
                {
                    "Value": "Скорость атаки"
                },
                {
                    "Value": "Attack Speed"
                },
                {
                    "Value": "Saldırı Hızı"
                }
            ]
        },
        {
            "Id": "attack_speed_description",
            "Lang": [
                {
                    "Value": "Зависит от оружия и ловкости."
                },
                {
                    "Value": "Depends on weapon and agility."
                },
                {
                    "Value": "Silaha ve çevikliğe bağlıdır."
                }
            ]
        },
        {
            "Id": "defense_name",
            "Lang": [
                {
                    "Value": "Защита"
                },
                {
                    "Value": "Defense"
                },
                {
                    "Value": "Savunma"
                }
            ]
        },
        {
            "Id": "defense_description",
            "Lang": [
                {
                    "Value": "Зависит от брони, выносливости и пассивок."
                },
                {
                    "Value": "Depends on armor, endurance, and passives."
                },
                {
                    "Value": "Zırha, dayanıklılığa ve pasiflere bağlıdır."
                }
            ]
        },
        {
            "Id": "critical_chance_name",
            "Lang": [
                {
                    "Value": "Шанс крита"
                },
                {
                    "Value": "Critical Chance"
                },
                {
                    "Value": "Kritik Şansı"
                }
            ]
        },
        {
            "Id": "critical_chance_description",
            "Lang": [
                {
                    "Value": "Зависит от ловкости, удачи и оружия."
                },
                {
                    "Value": "Depends on agility, luck, and weapon."
                },
                {
                    "Value": "Çevikliğe, şansa ve silaha bağlıdır."
                }
            ]
        },
        {
            "Id": "critical_damage_name",
            "Lang": [
                {
                    "Value": "Критический урон"
                },
                {
                    "Value": "Critical Damage"
                },
                {
                    "Value": "Kritik Hasar"
                }
            ]
        },
        {
            "Id": "critical_damage_description",
            "Lang": [
                {
                    "Value": "Зависит от оружия, способностей и редких предметов."
                },
                {
                    "Value": "Depends on weapon, abilities, and rare items."
                },
                {
                    "Value": "Silaha, yeteneklere ve nadir eşyalara bağlıdır."
                }
            ]
        },
        {
            "Id": "fatigue_name",
            "Lang": [
                {
                    "Value": "Усталость"
                },
                {
                    "Value": "Fatigue"
                },
                {
                    "Value": "Yorgunluk"
                }
            ]
        },
        {
            "Id": "fatigue_description",
            "Lang": [
                {
                    "Value": "Показывает накопленное истощение героя от тяжёлых задач и долгих приключений."
                },
                {
                    "Value": "Tracks a hero's accumulated exhaustion from heavy tasks and long adventures."
                },
                {
                    "Value": "Ağır görevler ve uzun maceralardan biriken kahraman yorgunluğunu izler."
                }
            ]
        }
    ]
}